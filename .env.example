# ---------------------------------------------------------------------------
# HOOPP Events Validation Ledger - environment
# Copy to .env (git-ignored). Every value below is a safe LOCAL DEV default.
# ---------------------------------------------------------------------------

# Database driver: "pglite" (embedded Postgres, zero install, default) or "postgres" (docker compose / Azure).
DB_DRIVER=pglite
# Used when DB_DRIVER=pglite. Use "memory://" for a throwaway in-memory DB.
PGLITE_DATA_DIR=.data/pglite
# Used when DB_DRIVER=postgres (matches docker-compose.yml).
DATABASE_URL=postgres://app:app@localhost:5432/hoopp_ledger

# Data lake root (filesystem implementation of LakeStore; ADLS Gen2 later).
LAKE_ROOT=.data/lake

# SIN protection keys: 32 bytes as 64 hex chars. REQUIRED in production, defaulted (with a warning) in dev.
# Generate fresh ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HMAC-SHA256 pepper for sin_pseudo (member stream ids). Rotating it changes every pseudonym.
SIN_PSEUDONYM_KEY=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0
# AES-256-GCM key for events_records.sin_enc (Rejected Individuals + export only).
SIN_ENC_KEY=a0b1c2d3e4f5061728394a5b6c7d8e9fa0b1c2d3e4f5061728394a5b6c7d8e9f

# Auth: "header" = dev headers x-user-id / x-user-role / x-employer-id. Entra ID provider arrives in Phase 4.
AUTH_MODE=header

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Feature flags / limits (architecture sections 13 and 18)
ALLOW_SUBMITTER_OVERRIDE=false
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_ROWS=50000
MAX_LINE_LENGTH=4096
BATCH_CONCURRENCY=2
# Q5: apply the I42 future-date check to RETFIN as well as TERFIN/DECFIN.
I42_APPLY_TO_RETFIN=true
# Q4: comma-separated rule ids to switch off (e.g. "I9").
RULES_DISABLED=
